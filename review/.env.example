# Copy to review/.env, chmod 600. Read by the systemd unit and by
# `node --env-file=review/.env`.

# --- Airtable -------------------------------------------------------------
# The same personal access token the site's /survey form and the sync script
# use. A pick is one write to the Pending Queue table; the free plan caps at
# 1,000 calls a month. See docs/airtable-spec-for-ai.md.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=apps8rBIORsmE7ij8
AIRTABLE_CANON_TABLE_ID=Canon
AIRTABLE_PENDING_QUEUE_TABLE_ID=Pending Queue

# --- Where it listens -----------------------------------------------------
# The host's tailnet address, because Caddy runs in a container and reaches
# this service over the tailnet, the same way it reaches kb-gateway. Read it
# with `tailscale ip -4`. The code defaults to 127.0.0.1, so this must be set
# for internal-site to reach it.
LAS_REVIEW_BIND=100.111.194.7
LAS_REVIEW_PORT=8789

# --- What it publishes ----------------------------------------------------
# The checkout the "Sync and publish" button runs in and pushes from. Defaults
# to the repository this file sits in. Point it at a checkout nobody edits by
# hand: the button refuses to run when anything outside data/ is dirty.
LAS_REVIEW_REPO=/home/stephen/las-largeagentsystems.org
LAS_REVIEW_BRANCH=main

# npm, for the four sync scripts. Absolute, for the same reason the unit's
# node path is absolute.
LAS_REVIEW_NPM=/home/stephen/.nvm/versions/node/v22.23.2/bin/npm

# --- Bookkeeping ----------------------------------------------------------
# The decision log, the rebuild lock and the last run's output. Defaults to
# review/state inside the checkout, which is gitignored.
LAS_REVIEW_STATE_DIR=/home/stephen/las-largeagentsystems.org/review/state

# Goes in the Pending Queue row's submitted_by, so a reviewer can see which
# door a row came in by.
LAS_REVIEW_REVIEWER=papers-review
